  itemName: "\u3010\u6CDB\u9EC4\u7684\u8BB0\u8005\u8BC1\u3011"
  description: "\u6DF1\u8910\u8272\u7684\u6CE5\u7070\u51E0\u4E4E\u6CBE\u6EE1\u4E86\u8FD9\u5F20\u8BB0\u8005\u8BC1\uFF0C\u5373\u4F7F\u7528\u6307\u8179\u4F7F\u52B2\u64E6\u53BB\u4E5F\u53EA\u80FD\u4F9D\u7A00\u8FA8\u8BA4\u8BB0\u8005\u7167\u7247\u7684\u4E00\u534A\u3002\u4F46\u662F\u4F60\u8FD8\u662F\u5F88\u5FEB\u8BA4\u51FA\u8FD9\u5F20\u8BB0\u8005\u8BC1\u7684\u4E3B\u4EBA\uFF0C\u4F60\u770B\u7740\u81EA\u5DF1\u4F20\u7EDF\u88C5\u626E\u7684\u6A21\u6837\uFF0C\u4F9D\u65E7\u9752\u6625\u7684\u8138\u5E9E\u548C\u73B0\u5728\u522B\u65E0\u4E8C\u81F4\u3002
    \_ \u4F60\u5728\u65F6\u7A7A\u88C2\u7F1D\u7684\u95F4\u9699\u6361\u5230\u4E86\u5B83\uFF0C\u771F\u7684\u662F\u987A\u624B\u6361\u8D77\u6765\u7684\u3002\u6216\u8BB8\u8FD8\u80FD\u6709\u7528\u5427\u2014\u2014\u5728\u90A3\u4E2A\u65F6\u4EE3\u3002\u6DF1\u8910\u8272\u7684\u6CE5\u7070\u51E0\u4E4E\u6CBE\u6EE1\u4E86\u8FD9\u5F20\u8BB0\u8005\u8BC1\uFF0C\u5373\u4F7F\u7528\u6307\u8179\u4F7F\u52B2\u64E6\u53BB\u4E5F\u53EA\u80FD\u4F9D\u7A00\u8FA8\u8BA4\u8BB0\u8005\u7167\u7247\u7684\u4E00\u534A\u3002\u4F46\u662F\u4F60\u8FD8\u662F\u5F88\u5FEB\u8BA4\u51FA\u8FD9\u5F20\u8BB0\u8005\u8BC1\u7684\u4E3B\u4EBA\uFF0C\u4F60\u770B\u7740\u81EA\u5DF1\u4F20\u7EDF\u88C5\u626E\u7684\u6A21\u6837\uFF0C\u4F9D\u65E7\u9752\u6625\u7684\u8138\u5E9E\u548C\u73B0\u5728\u522B\u65E0\u4E8C\u81F4\u3002
