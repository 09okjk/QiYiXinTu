  newsTitle: "[\u6821\u56ED\u901F\u9012]\u7ACB\u5FB7\u697C\"\u5496\u5983\"\u5F53\u4F17\u53DB\u9006\uFF01\u81EA\u52A9\u5496\u5561\u673A\u4E0A\u6F14\"\u62FF\u94C1\u55B7\u6CC9\u79C0\"
    \u4F5C\u8005\uFF1A\u8DEF\u85AA\u58F0 "
  newsContent: "\u65B0\u95FB\u5185\u5BB9\uFF1A\n\u4ECA\u65E5\u4E0A\u534810:15\uFF0C\u7ACB\u5FB7\u697C\u4E00\u5C42\u7684\u667A\u80FD\u5496\u5561\u673A\u5728\u5236\u4F5C\u7126\u7CD6\u739B\u5947\u6735\u65F6\u7A81\u7136\"\u60C5\u7EEA\u5931\u63A7\"\u3002\u636E\u76EE\u51FB\u8005\u63CF\u8FF0\uFF0C\u8BE5\u673A\u5668\u5148\u53D1\u51FA\u62D6\u62C9\u673A\u822C\u7684\u8F70\u9E23\uFF0C\u968F\u540E\u5236\u4F5C\u5496\u5561\u7684\u673A\u68B0\u624B\u81C2180\u5EA6\u65CB\u8F6C\uFF0C\u5C06\u6EDA\u70EB\u5496\u5561\u6DB2\u55B7\u5411\u673A\u5668\u5185\u90E8\uFF0C\u88F9\u631F\u7740\u6D53\u7F29\u5496\u5561\u9999\u7684\u7A7A\u6C14\u77AC\u95F4\u7B3C\u7F69\u6574\u4E2A\u8D70\u5ECA\u3002\u5C0F\u7EFF\u4E66\u5E73\u53F0\u4E0A\u7684\u6821\u53CB\u9510\u8BC4\uFF1A\u201D\u4EBA\u5DE5\u667A\u969C\u5FEB\u9000\u4F11\u5427\u3002\u201D"
  newsImageID: "\u65B0\u95FB\u901F\u901203"
